// Managed by Ansible - role: opencloud_check_docker
// Do not edit by hand, changes will be overwritten.
//
// Runs the check via `docker run --rm <image> ...`. Instance-specific
// values (host, port, proxy, insecure, debug, retries, backoff-factor) are
// intentionally NOT set here - they are set as custom variables on the
// Service object(s) using this CheckCommand, so the same command
// definition can be reused for multiple OpenCloud instances. Arguments
// whose macro resolves to null are omitted automatically by Icinga2.
object CheckCommand "{{ opencloud_check_command_name }}" {
    import "plugin-check-command"
    command = [ "{{ opencloud_check_docker_binary }}" ]

    arguments += {
        "run" = {
            order = -5
            value = "run"
        }
        "--rm" = {
            order = -4
            value = "--rm"
        }
        "image" = {
            order = -3
            skip_key = true
            value = "{{ opencloud_check_docker_image_name }}:{{ opencloud_check_docker_image_tag }}"
        }
        "--host" = {
            description = "OpenCloud hostname, IP or URL"
            required = true
            value = "$opencloud_host$"
        }
        "--proxy" = {
            description = "HTTP/HTTPS proxy (optional)"
            value = "$opencloud_proxy$"
        }
        "--port" = {
            description = "Port the instance listens on, e.g. 9200 (optional)"
            value = "$opencloud_port$"
        }
        "--insecure" = {
            description = "Do not verify the instance's TLS certificate (optional)"
            set_if = "$opencloud_insecure$"
        }
        "--no-debug-ports" = {
            description = "Skip probing the OpenCloud debug ports (optional)"
            set_if = "$opencloud_no_debug_ports$"
        }
        "--concurrency" = {
            description = "Probes run in parallel; 1 means no multithreading"
            value = "$opencloud_concurrency$"
        }
        "--update-source" = {
            description = "Where the newest release is looked up: auto, feed, pinned, bundled, off"
            value = "$opencloud_update_source$"
        }
        "--update-warning" = {
            description = "Report WARNING when a newer release is available (optional)"
            set_if = "$opencloud_update_warning$"
        }
        "--debug" = {
            description = "Enable debugging output (optional)"
            set_if = "$opencloud_debug$"
        }
        "--retries" = {
            description = "Retry attempts for transient network errors"
            value = "$opencloud_retries$"
        }
        "--backoff-factor" = {
            description = "Exponential backoff factor (seconds) between retries"
            value = "$opencloud_backoff_factor$"
        }
        "--timeout" = {
            description = "HTTP timeout in seconds per request"
            value = "$opencloud_timeout$"
        }
        "--warning" = {
            description = "Rating (0-5) at or below which the check warns"
            value = "$opencloud_warning$"
        }
        "--critical" = {
            description = "Rating (0-5) at or below which the check is critical"
            value = "$opencloud_critical$"
        }
        "--profile" = {
            description = "Named threshold set - strict, ops or lenient - judging the result instead of the defaults"
            value = "$opencloud_profile$"
        }
        "--policy" = {
            description = "Policy file of organization requirements; anything it asks for that is not met is CRITICAL"
            value = "$opencloud_policy$"
        }
        "--check-hardening" = {
            description = "Also report missing hardening measures and security headers"
            set_if = "$opencloud_check_hardening$"
        }
        "--webhook-url" = {
            description = "Optional endpoint notified when the check turns critical"
            value = "$opencloud_webhook_url$"
        }
        "--webhook-on" = {
            description = "Lowest state that triggers the webhook"
            value = "$opencloud_webhook_on$"
        }
        "--webhook-timeout" = {
            description = "HTTP timeout in seconds for the webhook call"
            value = "$opencloud_webhook_timeout$"
        }
        "--scheme" = {
            description = "Protocol the instance is reached over: https or http"
            value = "$opencloud_scheme$"
        }
        "--ca-file" = {
            description = "CA bundle the instance's certificate is verified against"
            value = "$opencloud_ca_file$"
        }
        "--config" = {
            description = "Configuration file for everything not set here"
            value = "$opencloud_config$"
        }
        "--no-extra-checks" = {
            description = "Skip the additional checks"
            set_if = "$opencloud_no_extra_checks$"
        }
        "--ignore-hardening" = {
            description = "Measures or checks to accept (array of names, wildcards allowed)"
            value = "$opencloud_ignore_hardening$"
            repeat_key = true
        }
        "--waive-until" = {
            description = "Time-limited waivers, PATTERN|EXPIRES|REASON (array)"
            value = "$opencloud_waive_until$"
            repeat_key = true
        }
        "--login-throttling" = {
            description = "Report whether failed sign-ins are throttled"
            set_if = "$opencloud_login_throttling$"
        }
        "--all-addresses" = {
            description = "Repeat the checks against every address the name resolves to"
            set_if = "$opencloud_all_addresses$"
        }
        "--release-track" = {
            description = "Release track the instance follows"
            value = "$opencloud_release_track$"
        }
        "--release-feed" = {
            description = "Release feed URL for the update check"
            value = "$opencloud_release_feed$"
        }
        "--release-token" = {
            description = "Bearer token for the release feed (secret:// references work)"
            value = "$opencloud_release_token$"
        }
        "--latest-version" = {
            description = "Pinned newest release, for --update-source pinned"
            value = "$opencloud_latest_version$"
        }
        "--no-update-check" = {
            description = "Skip the update check"
            set_if = "$opencloud_no_update_check$"
        }
        "--eol-warning" = {
            description = "WARNING this many days before the release line's end of life"
            value = "$opencloud_eol_warning$"
        }
        "--baseline" = {
            description = "File remembering the last run's findings"
            value = "$opencloud_baseline$"
        }
        "--warn-on-new" = {
            description = "WARNING when the baseline shows a new finding"
            set_if = "$opencloud_warn_on_new$"
        }
        "--diff-format" = {
            description = "How baseline changes are rendered: text, markdown, slack, json"
            value = "$opencloud_diff_format$"
        }
        "--webhook-format" = {
            description = "Webhook payload: generic, slack, discord, ntfy, gotify"
            value = "$opencloud_webhook_format$"
        }
        "--webhook-header" = {
            description = "Extra webhook headers, NAME:VALUE (array)"
            value = "$opencloud_webhook_header$"
            repeat_key = true
        }
        "--webhook-secret" = {
            description = "HMAC-SHA256 secret signing the webhook (secret:// references work)"
            value = "$opencloud_webhook_secret$"
        }
        "--allow-private-webhooks" = {
            description = "Allow a webhook URL on a private address"
            set_if = "$opencloud_allow_private_webhooks$"
        }
        "--webhook-digest" = {
            description = "Batch webhook notifications into a digest"
            set_if = "$opencloud_webhook_digest$"
        }
    }
}
