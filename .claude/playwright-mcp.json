{
  "browser": {
    "browserName": "webkit",
    "isolated": true,
    "launchOptions": {
      "headless": true,
      "proxy": {
        "server": "http://127.0.0.1:9",
        "bypass": "127.0.0.1,localhost,[::1]"
      }
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 900 },
      "reducedMotion": "reduce"
    }
  },
  "network": {
    "allowedOrigins": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "outputDir": ".playwright-mcp",
  "codegen": "python"
}
